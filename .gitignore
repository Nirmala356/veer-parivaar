# ==============================================================================
# Veer Parivaar - Root Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Files
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.crt

# ------------------------------------------------------------------------------
# 2. Java / Spring Boot / Maven Build Outputs
# ------------------------------------------------------------------------------
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/
.mvn/wrapper/maven-wrapper.jar
**/.mvn/wrapper/maven-wrapper.jar
classpath.txt
**/classpath.txt
bin/
**/bin/

# ------------------------------------------------------------------------------
# 3. Node / React / Vite Frontend Outputs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.oxlintcache
**/.oxlintcache

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Local Document Uploads & Temp Storage
# ------------------------------------------------------------------------------
uploads/
**/uploads/
.veer-parivaar/
**/.veer-parivaar/
*.tmp

# ------------------------------------------------------------------------------
# 6. IDEs & Editor Metadata
# ------------------------------------------------------------------------------
# Eclipse / STS
.apt_generated
**/.apt_generated
.classpath
**/.classpath
.factorypath
**/.factorypath
.project
**/.project
.settings/
**/.settings/
.springBeans
**/.springBeans
.sts4-cache
**/.sts4-cache

# IntelliJ IDEA
.idea/
**/.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/*
**/.vscode/*
!.vscode/extensions.json
!**/.vscode/extensions.json

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
**/.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
